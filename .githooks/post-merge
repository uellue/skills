#!/bin/sh
# After a pull or merge on main: report hashes cited in the records that a rebase merge moved off main
# (ledger 220). Reports only; apply on the next branch with python3 .githooks/rehash.py --apply.
# Never fails the pull, but says when the report could not run.
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
if ! out=$(python3 "$(git rev-parse --show-toplevel)/.githooks/rehash.py" --onto main 2>&1); then
  printf 'post-merge: the check of cited hashes could not run:\n%s\n' "$out" >&2
  exit 0
fi
[ -n "$out" ] && printf 'post-merge: cited hashes no longer on main:\n%s\n' "$out" >&2
exit 0
