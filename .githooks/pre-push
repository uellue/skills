#!/bin/sh
# Two checks of the commits a push would publish.
#
# 1. The plugin's version (ledger 222): installed copies stay on a version until it changes, so a change under
#    plugins/kaizen/ without a new version in its plugin.json never reaches them. Compared with origin/main:
#    a push to main is refused, a push of another branch warns (the bump can come in a later commit).
#
# 2. The denylist: refuses a push whose new commits add a line, or carry a commit message, matching the local
#    denylist .git/info/denylist (one extended regular expression per line, # for comments). The denylist is
#    never committed: it names what must not become public (other projects' internals, security findings).
#    Only added lines and the names of files count, so removing or generalising an already-public line is
#    not refused. Text added only in a merge's conflict resolution is not seen (git log -p shows no diff for it).
refs=$(cat)
zero=0000000000000000000000000000000000000000
status=0

plugin=plugins/kaizen
manifest=$plugin/.claude-plugin/plugin.json
upstream=refs/remotes/origin/main
if git rev-parse -q --verify "$upstream" >/dev/null; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ] && continue
    git diff --quiet "$upstream" "$local_sha" -- "$plugin" && continue
    new=$(git show "$local_sha:$manifest" 2>/dev/null | grep '"version"')
    old=$(git show "$upstream:$manifest" 2>/dev/null | grep '"version"')
    [ "$new" != "$old" ] && continue
    if [ "$remote_ref" = refs/heads/main ]; then
      echo "pre-push: $plugin changed since origin/main but its version did not; bump it in $manifest. Push refused." >&2
      status=1
    else
      echo "pre-push: $local_ref changes $plugin but not its version; bump it in $manifest before this reaches main." >&2
    fi
  done <<EOF
$refs
EOF
fi

list="$(git rev-parse --git-path info/denylist)"
if patterns=$(grep -v -e '^#' -e '^[[:space:]]*$' "$list" 2>/dev/null); then
  re=$(printf '%s\n' "$patterns" | paste -sd '|' -)
  printf '' | grep -E -e "$re" >/dev/null 2>&1
  if [ $? -eq 2 ]; then
    echo "pre-push: $list holds an invalid pattern; push refused until it is fixed." >&2
    exit 1
  fi
  denied=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
    # shellcheck disable=SC2086
    hits=$( { git log --format=%B $range; git log --name-only --diff-filter=ACR --format= $range;
              git log -p --no-color --format= $range | grep '^+' | grep -v '^+++'; } \
      | grep -n -E -e "$re" | head -5)
    if [ -n "$hits" ]; then
      echo "pre-push: $local_ref adds denylisted text (from $list):" >&2
      echo "$hits" >&2
      denied=1
    fi
  done <<EOF
$refs
EOF
  if [ $denied -eq 1 ]; then
    echo "pre-push: reword it, decide whether to rewrite the unpushed history, or push with --no-verify after deciding it may go public." >&2
    status=1
  fi
fi
exit $status
