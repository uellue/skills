#!/bin/sh
# Warns, never refuses (CLAUDE.md, ledger 220 and 312):
# - when a commit changes the plugin, the design records or the benchmarks and its message has no Ledger:
#   trailer naming the ledger rows it serves; the trailer survives rebase merges, so `git log --grep` finds a
#   row's commits after their hashes have changed;
# - when a row it names cites an issue ("issue 13", "#13") and the message has no "Refs #13" (or Closes);
# - when the message closes an issue on merge (Closes, Fixes, Resolves): only after the manager confirmed.
msg="$1"
top=$(git rev-parse --show-toplevel)
if git diff --cached --name-only | grep -q -E '^(plugins|design|benchmarks)/'; then
    # Case-sensitive, as `git log --grep` is; a rewording amend with nothing staged is not checked.
    git interpret-trailers --parse "$msg" | grep -q '^Ledger: *[0-9]' ||
        echo "commit-msg: no 'Ledger: <rows>' trailer; add one if this commit serves ledger rows (CLAUDE.md). Committed anyway." >&2
fi
rows=$(git interpret-trailers --parse "$msg" | sed -n 's/^Ledger: *//p' | tr -c '0-9\n' ' ')
for row in $rows; do
    line=$(cat "$top/design/kaizen.md" "$top"/design/archive/*.md 2>/dev/null | grep -m 1 -E "^\| $row \|")
    for n in $(printf '%s\n' "$line" | grep -o -i -E '(issue #?|#)[0-9]+' | grep -o -E '[0-9]+' | sort -u); do
        grep -q -i -E "^(refs|closes|fixes|resolves) +#$n([^0-9]|$)" "$msg" ||
            echo "commit-msg: ledger row $row cites issue $n; add 'Refs #$n' (or 'Closes #$n' once the manager confirmed the issue can be closed). Committed anyway." >&2
    done
done
grep -i -E '^(close[sd]?|fix(e[sd])?|resolve[sd]?) +#[0-9]+' "$msg" | while read -r word ref _; do
    echo "commit-msg: '$word $ref' closes the issue when this reaches the default branch; only after the manager confirmed it can be closed." >&2
done
exit 0
