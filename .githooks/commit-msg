#!/bin/sh
# Warns, never refuses (CLAUDE.md, ledger 220 and 312):
# - when a commit changes the plugin, the design records or the benchmarks and its message has no Ledger:
#   trailer naming the ledger rows it serves; the trailer survives rebase merges, so `git log --grep` finds a
#   row's commits after their hashes have changed;
# - when a row it names cites an issue ("issue 13", "issue #13") and the message has no "Refs #13" (or a
#   closing keyword);
# - when the message closes an issue on merge (Closes, Fixes, Resolves): only after the person confirmed.
msg="$1"
top=$(git rev-parse --show-toplevel)
# git drops comment lines, and with `commit -v` everything below its scissors line (the staged diff)
body=$(sed '/^# -* >8 -*$/,$d' "$msg" | grep -v '^#')
if git diff --cached --name-only | grep -q -E '^(plugins|design|benchmarks)/'; then
    # Case-sensitive, as `git log --grep` is; a rewording amend with nothing staged is not checked.
    if git interpret-trailers --parse "$msg" | grep -q '^Ledger: *[0-9]'; then :
    elif printf '%s\n' "$body" | grep -q '^Ledger: *[0-9]'; then
        # a line such as "Refs #13" among the trailers makes git read none of them (2026-11-19, 47c7383)
        echo "commit-msg: the Ledger: line is not read as a trailer: the last paragraph must hold only 'Key: value' lines (a 'Refs #<n>' line belongs in the body). Committed anyway." >&2
    else
        echo "commit-msg: no 'Ledger: <rows>' trailer; add one if this commit serves ledger rows (CLAUDE.md). Committed anyway." >&2
    fi
fi
keywords='(refs|close[sd]?|fix(e[sd])?|resolve[sd]?)'
rows=$(git interpret-trailers --parse "$msg" | sed -n 's/^Ledger: *//p' | tr -c '0-9\n' ' ')
for row in $rows; do
    line=$(cat "$top/design/kaizen.md" "$top"/design/archive/*.md 2>/dev/null | grep -m 1 -E "^\| $row \|")
    for n in $(printf '%s\n' "$line" | grep -o -i -E '(^|[^a-z])issues? #?[0-9]+' | grep -o -E '[0-9]+$' | sort -u); do
        printf '%s\n' "$body" | grep -q -i -E "(^|[^a-z])$keywords:? +#$n([^0-9]|$)" ||
            echo "commit-msg: ledger row $row cites issue $n; add 'Refs #$n' (or 'Closes #$n' once the person confirmed the issue can be closed). Committed anyway." >&2
    done
done
printf '%s\n' "$body" | grep -o -i -E "(^|[^a-z])(close[sd]?|fix(e[sd])?|resolve[sd]?):? +#[0-9]+" | sed 's/^[^a-zA-Z]*//' |
    while read -r word ref; do
        echo "commit-msg: '$word $ref' closes the issue when this reaches the default branch; only after the person confirmed it can be closed." >&2
    done
exit 0
