#!/bin/sh
# Enabled with: git config core.hooksPath .githooks
# It checks the working tree, not the staged index: commit everything you changed, or the check may pass on unstaged edits.
#
# git hands a hook its own variables (GIT_INDEX_FILE, GIT_AUTHOR_DATE, GIT_CONFIG_PARAMETERS, ...); with
# `git commit -a`, GIT_INDEX_FILE is the absolute path of this repository's temporary index, so the tests'
# git calls in their scratch repositories would write into this commit (ledger 279). The check needs none of them.
for v in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
./check.sh -q || { echo "pre-commit: ./check.sh failed; commit refused" >&2; exit 1; }
